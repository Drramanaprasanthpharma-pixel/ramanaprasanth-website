# Supabase project credentials
# Create a free project at https://supabase.com, run supabase/schema.sql then supabase/seed.sql
# in the SQL editor, and paste the values below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple shared password gate for the admin panel (change this).
# For real hospital deployment, replace with Supabase Auth + role-based access.
ADMIN_ACCESS_CODE=change-me-please

# Optional: shown in the report footer / header
NEXT_PUBLIC_HOSPITAL_NAME="Your Hospital Name"
